# check if we have a gpu, if not just use cpu (5-6 optional gpu thing)
DEVICE = torch.device("cuda" if torch.cuda.is_available() else "cpu")
print(f"using device: {DEVICE}")


# ─────────────────────────────────────────────────────────
# 5-1: loading the datasets
# node file: node_id  feat1 feat2 ... featN  class_label
# link file: src_id  dst_id
# ─────────────────────────────────────────────────────────

def load_dataset(dataset_name, data_dir="./stage_5_data"):
    dataset_name = dataset_name.lower()
    path = os.path.join(data_dir, dataset_name)

    node_file = os.path.join(path, "node")
    link_file = os.path.join(path, "link")

    # ── read node file ───────────────────────────────────────
    # format might be: node_id feat1 feat2 ... featN class_label
    # or just: feat1 feat2 ... featN class_label
    # checking if first col looks like an id
    node_ids     = []
    node_feats   = []
    label_strings = []

    with open(node_file, "r") as f:
        lines = [l.strip() for l in f if l.strip()]

    # peek at first line to figure out format
    first = lines[0].split()
    # check if first token is a plain integer (node id) vs a float feature
    try:
        int(first[0])
        float(first[1])
        # first col is int, second is float -> likely node_id + features + label
        has_id_col = True
    except:
        has_id_col = False

    for line in lines:
        parts = line.split()
        if has_id_col:
            node_ids.append(int(parts[0]))
            label_strings.append(parts[-1])
            node_feats.append([float(x) for x in parts[1:-1]])
        else:
            label_strings.append(parts[-1])
            node_feats.append([float(x) for x in parts[:-1]])

    # if we had explicit node ids, build a mapping to 0-indexed
    if has_id_col:
        id_to_idx = {nid: i for i, nid in enumerate(node_ids)}
    else:
        id_to_idx = None

    features  = np.array(node_feats, dtype=np.float32)
    num_nodes = features.shape[0]

    # convert string labels to integers
    unique_labels = sorted(set(label_strings))
    label_map     = {l: i for i, l in enumerate(unique_labels)}
    labels        = np.array([label_map[l] for l in label_strings], dtype=np.int64)

    # ── read link file ───────────────────────────────────────
    src_list, dst_list = [], []
    with open(link_file, "r") as f:
        for line in f:
            parts = line.strip().split()
            if len(parts) < 2:
                continue
            s, d = int(parts[0]), int(parts[1])
            # remap to 0-indexed if we have explicit node ids
            if id_to_idx is not None:
                if s not in id_to_idx or d not in id_to_idx:
                    continue  # skip edges to unknown nodes
                s = id_to_idx[s]
                d = id_to_idx[d]
            src_list.append(s)
            dst_list.append(d)

    # if no id col, still check if ids are 1-indexed
    if id_to_idx is None:
        min_id = min(min(src_list), min(dst_list)) if src_list else 0
        if min_id == 1:
            src_list = [s - 1 for s in src_list]
            dst_list = [d - 1 for d in dst_list]

    # clamp any ids that are out of range just in case
    src_list = [s for s, d in zip(src_list, dst_list) if 0 <= s < num_nodes and 0 <= d < num_nodes]
    dst_list = [d for s, d in zip(src_list, dst_list) if 0 <= s < num_nodes and 0 <= d < num_nodes]
    # redo filter properly
    valid = [(s, d) for s, d in zip(
        [int(parts[0]) for parts in [l.strip().split() for l in open(link_file) if l.strip() and len(l.strip().split()) >= 2]],
        [int(parts[1]) for parts in [l.strip().split() for l in open(link_file) if l.strip() and len(l.strip().split()) >= 2]]
    ) if True]

    # rebuild properly
    src_list, dst_list = [], []
    with open(link_file, "r") as f:
        for line in f:
            parts = line.strip().split()
            if len(parts) < 2:
                continue
            s, d = int(parts[0]), int(parts[1])
            if id_to_idx is not None:
                if s not in id_to_idx or d not in id_to_idx:
                    continue
                s = id_to_idx[s]
                d = id_to_idx[d]
            if 0 <= s < num_nodes and 0 <= d < num_nodes:
                src_list.append(s)
                dst_list.append(d)

    # build undirected adjacency matrix with self loops
    rows = src_list + dst_list
    cols = dst_list + src_list
    adj = sp.coo_matrix(
        (np.ones(len(rows)), (rows, cols)),
        shape=(num_nodes, num_nodes), dtype=np.float32
    )
    adj = adj + sp.eye(num_nodes)   # self loops
    adj = _normalize_adj(adj)       # D^(-1/2) A D^(-1/2)

    # ── train/val/test split ─────────────────────────────────
    np.random.seed(42)
    idx     = np.random.permutation(num_nodes)
    n_train = int(0.6 * num_nodes)
    n_val   = int(0.2 * num_nodes)

    train_mask = np.zeros(num_nodes, dtype=bool)
    val_mask   = np.zeros(num_nodes, dtype=bool)
    test_mask  = np.zeros(num_nodes, dtype=bool)

    train_mask[idx[:n_train]]            = True
    val_mask[idx[n_train:n_train+n_val]] = True
    test_mask[idx[n_train+n_val:]]       = True

    return features, adj, labels, train_mask, val_mask, test_mask


def _normalize_adj(adj):
    # symmetric normalization: D^(-1/2) * A * D^(-1/2)
    adj        = sp.coo_matrix(adj)
    d          = np.array(adj.sum(1)).flatten()
    d_inv_sqrt = np.power(d, -0.5)
    d_inv_sqrt[np.isinf(d_inv_sqrt)] = 0.0
    D = sp.diags(d_inv_sqrt)
    return (D @ adj @ D).tocoo()


def sparse_to_torch(sparse_mx):
    sparse_mx = sparse_mx.tocoo().astype(np.float32)
    indices   = torch.from_numpy(
        np.vstack((sparse_mx.row, sparse_mx.col)).astype(np.int64)
    )
    values = torch.from_numpy(sparse_mx.data)
    shape  = torch.Size(sparse_mx.shape)
    return torch.sparse_coo_tensor(indices, values, shape)


def inspect_dataset(features, adj, labels, train_mask, val_mask, test_mask, name="dataset"):
    print(f"\n{'='*50}")
    print(f"  dataset: {name.upper()}")
    print(f"{'='*50}")
    print(f"  nodes       : {features.shape[0]:,}")
    print(f"  features    : {features.shape[1]:,}")
    print(f"  classes     : {len(np.unique(labels))}")
    num_edges = (adj.nnz - features.shape[0]) // 2
    print(f"  edges       : {num_edges:,}")
    print(f"  train nodes : {train_mask.sum():,}")
    print(f"  val nodes   : {val_mask.sum():,}")
    print(f"  test nodes  : {test_mask.sum():,}")
    print(f"{'─'*50}")


# ─────────────────────────────────────────────────────────
# 5-2: building the gcn model from scratch
# formula: H' = sigma(A_hat * H * W)
# ─────────────────────────────────────────────────────────

class GraphConvLayer(nn.Module):
    def __init__(self, in_features, out_features, bias=True):
        super().__init__()
        self.in_features  = in_features
        self.out_features = out_features
        self.weight = nn.Parameter(torch.FloatTensor(in_features, out_features))
        self.bias   = nn.Parameter(torch.FloatTensor(out_features)) if bias else None
        self._reset_parameters()

    def _reset_parameters(self):
        # xavier init - keeps gradients stable
        stdv = 1.0 / math.sqrt(self.weight.size(1))
        self.weight.data.uniform_(-stdv, stdv)
        if self.bias is not None:
            self.bias.data.uniform_(-stdv, stdv)

    def forward(self, x, adj):
        # step 1: linear transform H * W
        support = torch.mm(x, self.weight)
        # step 2: aggregate neighbors A_hat * (H*W)
        output  = torch.spmm(adj, support)
        if self.bias is not None:
            output = output + self.bias
        return output

    def __repr__(self):
        return f"GraphConvLayer(in={self.in_features}, out={self.out_features})"


class GCN(nn.Module):
    # 2-layer gcn: input -> hidden -> output
    def __init__(self, nfeat, nhid, nclass, dropout=0.5):
        super().__init__()
        self.gc1     = GraphConvLayer(nfeat, nhid)
        self.gc2     = GraphConvLayer(nhid, nclass)
        self.dropout = dropout

    def forward(self, x, adj):
        # layer 1 - node embeddings
        h = F.relu(self.gc1(x, adj))
        h = F.dropout(h, p=self.dropout, training=self.training)
        # layer 2 - class predictions
        out = self.gc2(h, adj)
        return F.log_softmax(out, dim=1)

    def embed(self, x, adj):
        # just get the hidden embeddings, no grad needed
        with torch.no_grad():
            return F.relu(self.gc1(x, adj))


# ─────────────────────────────────────────────────────────
# 5-3 and 5-4: training and evaluating
# ─────────────────────────────────────────────────────────

def accuracy(logits, labels, mask):
    pred = logits[mask].argmax(dim=1)
    return (pred == labels[mask]).float().mean().item()


def train_one_epoch(model, optimizer, adj, features, labels, train_mask):
    model.train()
    optimizer.zero_grad()
    out  = model(features, adj)
    loss = F.nll_loss(out[train_mask], labels[train_mask])
    loss.backward()
    optimizer.step()
    return loss.item(), accuracy(out, labels, train_mask)


@torch.no_grad()
def evaluate(model, adj, features, labels, mask):
    model.eval()
    out  = model(features, adj)
    loss = F.nll_loss(out[mask], labels[mask]).item()
    return loss, accuracy(out, labels, mask)


def run_experiment(dataset_name, data_dir="./stage_5_data", nhid=64, dropout=0.5,
                   lr=0.01, weight_decay=5e-4, epochs=200, patience=30,
                   plot_dir="./plots"):
    os.makedirs(plot_dir, exist_ok=True)

    print(f"\nloading {dataset_name}...")
    features, adj, labels, train_mask, val_mask, test_mask = load_dataset(dataset_name, data_dir)
    inspect_dataset(features, adj, labels, train_mask, val_mask, test_mask, name=dataset_name)

    features_t   = torch.FloatTensor(features).to(DEVICE)
    adj_t        = sparse_to_torch(adj).to(DEVICE)
    labels_t     = torch.LongTensor(labels).to(DEVICE)
    train_mask_t = torch.BoolTensor(train_mask).to(DEVICE)
    val_mask_t   = torch.BoolTensor(val_mask).to(DEVICE)
    test_mask_t  = torch.BoolTensor(test_mask).to(DEVICE)

    nfeat     = features_t.shape[1]
    nclass    = int(labels_t.max().item()) + 1
    model     = GCN(nfeat=nfeat, nhid=nhid, nclass=nclass, dropout=dropout).to(DEVICE)
    optimizer = optim.Adam(model.parameters(), lr=lr, weight_decay=weight_decay)

    print(f"\n  model: {model}")
    print(f"  total parameters: {sum(p.numel() for p in model.parameters()):,}")

    history = {"train_loss": [], "val_loss": [], "train_acc": [], "val_acc": []}
    best_val_acc = 0.0
    best_state   = None
    no_improve   = 0
    t0           = time.time()

    for epoch in range(1, epochs + 1):
        tr_loss, tr_acc = train_one_epoch(model, optimizer, adj_t, features_t, labels_t, train_mask_t)
        vl_loss, vl_acc = evaluate(model, adj_t, features_t, labels_t, val_mask_t)

        history["train_loss"].append(tr_loss)
        history["val_loss"].append(vl_loss)
        history["train_acc"].append(tr_acc)
        history["val_acc"].append(vl_acc)

        if vl_acc > best_val_acc:
            best_val_acc = vl_acc
            best_state   = {k: v.cpu().clone() for k, v in model.state_dict().items()}
            no_improve   = 0
        else:
            no_improve += 1

        if epoch % 20 == 0 or epoch == 1:
            print(f"  epoch {epoch:>3d} | train loss {tr_loss:.4f}  acc {tr_acc:.4f} | val loss {vl_loss:.4f}  acc {vl_acc:.4f}")

        if no_improve >= patience:
            print(f"  early stopping at epoch {epoch}")
            break

    elapsed = time.time() - t0
    print(f"\n  training done! took {elapsed:.1f}s")

    model.load_state_dict({k: v.to(DEVICE) for k, v in best_state.items()})
    te_loss, te_acc = evaluate(model, adj_t, features_t, labels_t, test_mask_t)

    print(f"\n  best val acc : {best_val_acc:.4f}")
    print(f"  test loss    : {te_loss:.4f}")
    print(f"  test acc     : {te_acc:.4f}")

    _plot_curves(history, dataset_name, te_acc, plot_dir)

    return {
        "dataset": dataset_name, "test_loss": te_loss,
        "test_acc": te_acc, "best_val": best_val_acc,
        "epochs": len(history["train_loss"]), "time_s": elapsed,
    }


def _plot_curves(history, name, test_acc, plot_dir):
    epochs = range(1, len(history["train_loss"]) + 1)
    fig, axes = plt.subplots(1, 2, figsize=(12, 4))
    fig.suptitle(f"gcn - {name}  (test acc = {test_acc:.4f})", fontsize=13)

    axes[0].plot(epochs, history["train_loss"], label="train")
    axes[0].plot(epochs, history["val_loss"],   label="val")
    axes[0].set_xlabel("epoch"); axes[0].set_ylabel("nll loss")
    axes[0].set_title("loss curve"); axes[0].legend(); axes[0].grid(alpha=0.3)

    axes[1].plot(epochs, history["train_acc"], label="train")
    axes[1].plot(epochs, history["val_acc"],   label="val")
    axes[1].set_xlabel("epoch"); axes[1].set_ylabel("accuracy")
    axes[1].set_title("accuracy curve"); axes[1].legend(); axes[1].grid(alpha=0.3)

    plt.tight_layout()
    fpath = os.path.join(plot_dir, f"gcn_{name}_curves.png")
    plt.savefig(fpath, dpi=150, bbox_inches="tight")
    plt.close()
    print(f"  saved learning curves to {fpath}")


def print_summary(results):
    print(f"\n{'='*65}")
    print(f"  {'dataset':<12} {'test acc':>9} {'val acc':>9} {'epochs':>7} {'time (s)':>9}")
    print(f"{'─'*65}")
    for r in results:
        print(f"  {r['dataset'].capitalize():<12} {r['test_acc']:>9.4f} {r['best_val']:>9.4f} {r['epochs']:>7d} {r['time_s']:>9.1f}")
    print(f"{'='*65}")


